# ============================================================
# 知识库管理系统 · 配置模板
# 复制为 .env 后按实际环境填写；.env 已被 .gitignore 忽略
# go run ./cmd/server 会自动加载本文件；已存在的进程环境变量优先，不会被覆盖
# 手工加载（例如 psql 需要用 DSN）：set -a; . ./.env; set +a
#
# 注意优先级：进程环境变量 > data/instance.env > 本文件 > 代码默认值。
# 「设置 → 部署 → 实例配置」会把 PG_DSN / VECTOR_STORE / CHROMA_* /
# LISTEN_ADDR / UPLOAD_DIR / BRAND_DIR 写进 data/instance.env。
# 一旦在页面上保存过，改这里对应的键不会生效——要么在页面上改，
# 要么删掉 data/instance.env 里那一行（或整个文件）回到本文件。
# ============================================================

# ---------- 服务 ----------
PORT=8080
# 默认仅本机访问。部署到反向代理后，可按需设为 0.0.0.0:8080。
# LISTEN_ADDR=0.0.0.0:8080
# Gin 运行模式：debug（默认，开发）或 release（生产）
# GIN_MODE=debug

# ---------- PostgreSQL ----------
# 业务数据（units/hazards/audit_records/index_jobs/documents/agent_runs/agent_steps）
# 始终通过这个 DSN 访问。选择 pgvector 时，向量表也在同一个库中。
# 若后端运行在容器/VM 内而数据库在宿主机，把 127.0.0.1 换成 host.docker.internal。
PG_DSN='postgresql://postgres:password@127.0.0.1:5432/knowledge_base?sslmode=disable'

# 向量存储：
#   chroma   —— 本地开发默认，向量写入 Chroma，需填写文末 CHROMA_* 并先启动 Chroma
#   pgvector —— 线上/一体化部署，需执行 deploy/schema-pgvector.sql
VECTOR_STORE=chroma

# ---------- 上传与索引 ----------
UPLOAD_DIR=./data/uploads
# 自定义图标存放目录。多实例部署时挂共享卷，否则只有上传的那台能看到图标。
# 目录与 uploads 同级，备份时一起带走。
BRAND_DIR=./data/brand
# 单文件上传上限（MB）
MAX_UPLOAD_MB=50
# 单个索引任务超时（分钟）
INDEX_TIMEOUT_MINUTES=15
# 同时处理的索引任务数（默认 1，最大 4）
INDEX_CONCURRENCY=1
# 切块尺寸（字符）与相邻片段重叠。条款型文档建议调小（如 800-1200），
# 叙述型文档可放大。索引时会把策略名写入 documents.chunker；
# 改了尺寸需要重建索引，否则新旧片段粒度不一致。
CHUNK_SIZE=1800
CHUNK_OVERLAP=240

# ---------- 日志 ----------
# app.log（应用/索引/模型）、access.log（HTTP 访问）、error.log（ERROR 汇总）
LOG_DIR=./logs
# debug / info / warn / error
LOG_LEVEL=info
# text 或 json
LOG_FORMAT=text
# 同时输出到 stdout（systemd 会进 journald）
LOG_CONSOLE=true
# 单文件轮转大小（MB），0 表示不轮转
LOG_MAX_SIZE_MB=50
# 每类日志保留的轮转历史文件数
LOG_MAX_BACKUPS=10

# ---------- Embedding（OpenAI-compatible） ----------
EMBED_BASE_URL=https://api.siliconflow.cn/v1
EMBED_API_KEY=
EMBED_MODEL=BAAI/bge-m3
# 向量维度，需与 embedding 模型输出一致。
# 索引时会把模型名与维度一起写入 documents.embedding_model / embedding_dim，
# 检索前比对：换模型或换维度后未重建索引时，会直接返回可操作的错误，
# 而不是让两套向量静默混算（那种故障不报错，只表现为检索变差）。
EMBED_DIMENSIONS=1024

# ---------- Chat Completion（OpenAI-compatible） ----------
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# ---------- MCP ----------
# 留空时 POST /mcp 返回 503；启用时填写强随机值，例如：openssl rand -hex 32
# 必须与 WorkBuddy 连接器里填写的 token 一致。
MCP_AUTH_TOKEN=

# ---------- Agent 配置 ----------
# 单次对话允许的最大工具调用步数（1-12）
AGENT_MAX_STEPS=6
# 注意：JSON 值必须用单引号包裹，否则 `source .env` 时会被 shell 的
# 花括号展开/通配符解析破坏。留空数组表示使用代码内置的专家和技能。
AGENT_EXPERTS_JSON='[]'
AGENT_SKILLS_JSON='[]'
MCP_CONNECTORS_JSON='[]'
# 配置示例（取消注释即可启用）：
# AGENT_EXPERTS_JSON='[{"id":"kb-expert","name":"知识库专家","description":"知识库问答","system_prompt":"依据档案回答，缺少证据时说明。"}]'
# AGENT_SKILLS_JSON='[{"id":"archive-search","name":"档案检索","description":"检索项目资料","instructions":"引用检索到的文件名。"}]'
# MCP_CONNECTORS_JSON='[{"name":"kb-mcp","url":"https://kb.example.com/mcp","enabled":true}]'

# ---------- Chroma（VECTOR_STORE=chroma 时生效） ----------
# 业务数据仍然存放在 PostgreSQL；只有文档向量写入 Chroma。
# 服务启动时会 get_or_create collection，Chroma 不可用会导致启动失败。
CHROMA_URL=http://127.0.0.1:8000
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database
CHROMA_COLLECTION=knowledge_base

# ---------- 联网搜索（可选） ----------
# 默认关闭：只有这里开启、且用户在本轮对话勾选「联网搜索」时才会调用外部搜索。
# 搜索关键词会离开本机，请确认合规后再开启。
WEB_SEARCH_ENABLED=false
# tavily | bocha | brave
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_API_KEY=
# WEB_SEARCH_BASE_URL=
WEB_SEARCH_TIMEOUT_MS=15000
WEB_SEARCH_CACHE_TTL_SECONDS=900
WEB_SEARCH_CACHE_ENTRIES=200
# 站点白名单/黑名单（逗号分隔）：ALLOW 留空表示不限站点
# WEB_SEARCH_ALLOW_DOMAINS=gov.cn,mem.gov.cn
# WEB_SEARCH_DENY_DOMAINS=

# ---------- 访问控制（可选） ----------
# 非空时所有 /api/ 请求需要带 Authorization: Bearer <token> 或 X-API-Token
# API_TOKEN=

# ---------- 检索增强（可选，默认已启用） ----------
# 混合检索：向量 + 关键词（pg_trgm）各取前 N 条，RRF 融合后重排。
RETRIEVAL_VECTOR_K=30
RETRIEVAL_KEYWORD_K=30
RETRIEVAL_FUSION_K=20
# 重排不可用时的距离兜底（cosine distance，越小越相关）
RETRIEVAL_MAX_DISTANCE=0.55
# 问题与片段的二元组覆盖率下限，低于它直接判为无依据（严格拒答的第二道闸门）
RETRIEVAL_MIN_OVERLAP=0.28

# 重排（cross-encoder）：优先使用设置页选择的来源或手工配置；
# 两者都没有时沿用对话模型的端点与密钥，只需覆盖模型名。
# 这里的 RERANK_* 是环境变量兜底，界面上改了会优先于它们。
# RERANK_BASE_URL=https://api.siliconflow.cn/v1
# RERANK_API_KEY=
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# 关闭重排（检索退化为向量+关键词融合，拒答会变松）
RERANK_ENABLED=true
# 低于该分数的片段不进入上下文，直接走拒答
RERANK_MIN_SCORE=0.1
